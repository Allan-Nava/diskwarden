# {{ ansible_managed }}
# Generated by the diskwarden Ansible role — edit the role variables, not this.

MOUNTPOINT="{{ diskwarden_mountpoint }}"
ROUTINE_THRESHOLD={{ diskwarden_routine_threshold }}
EMERGENCY_THRESHOLD={{ diskwarden_emergency_threshold }}

LOG_FILE="{{ diskwarden_log_path }}"

ARCHIVED_LOG_DAYS={{ diskwarden_archived_log_days }}
ROTATED_LOG_DAYS={{ diskwarden_rotated_log_days }}
JOURNAL_KEEP_DAYS={{ diskwarden_journal_keep_days }}
TMP_DAYS={{ diskwarden_tmp_days }}
CRASHDUMP_DAYS={{ diskwarden_crashdump_days }}
CONTAINER_IMAGE_DAYS={{ diskwarden_container_image_days }}

ACTIVE_LOG_TRUNCATE_MB={{ diskwarden_active_log_truncate_mb }}
CONTAINER_JSON_TRUNCATE_MB={{ diskwarden_container_json_truncate_mb }}

{% if diskwarden_extra_log_dirs %}
EXTRA_LOG_DIRS=({% for d in diskwarden_extra_log_dirs %}"{{ d }}"{{ " " if not loop.last }}{% endfor %})
{% else %}
EXTRA_LOG_DIRS=()
{% endif %}

MODULES="{{ diskwarden_modules }}"
